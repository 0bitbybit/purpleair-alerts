# For local runs: copy to .env, fill in, then `set -a; source .env; set +a`
# In GitHub: add each of these as a repository secret instead.
PURPLEAIR_API_KEY=your-read-key-from-develop.purpleair.com

# Email (Gmail needs an App Password, not your normal password)
EMAIL_URLS=mailtos://you:app-password@gmail.com?to=you@example.com

# Text messages via Twilio: twilio://ACCOUNT_SID:AUTH_TOKEN@FROM_NUMBER/TO_NUMBER
SMS_URLS=twilio://ACxxxxxxxx:token@+15551230000/+15559870000
